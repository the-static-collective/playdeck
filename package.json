{
  "name": "playdeck",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "studio": "npm --workspace @playdeck/studio run dev",
    "render:genesis": "npm --workspace @playdeck/render-remotion run render:genesis",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compose:genesis": "npm --workspace @playdeck/composer run compose:genesis",
    "receipt:genesis": "npm --workspace @playdeck/receipts run receipt:genesis",
    "continuity:proof": "npm --workspace @playdeck/continuity run continuity:proof",
    "ingest:proof": "npm --workspace @playdeck/ingest run ingest:proof",
    "command:proof": "npm --workspace @playdeck/cli run command:proof",
    "album:proof": "npm --workspace @playdeck/album run album:proof",
    "studio:build": "npm --workspace @playdeck/studio run build",
    "studio:proof": "npm --workspace @playdeck/studio run proof",
    "studio:remotion": "npm --workspace @playdeck/render-remotion run studio"
  }
}
